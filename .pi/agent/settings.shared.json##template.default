{
  "hideThinkingBlock": true,
  "packages": [
    {
      "source": "npm:pi-web-access",
      "skills": [
        "-skills/librarian/SKILL.md"
      ]
    },
    {
      "source": "{{env.HOME}}/dev/pi-anthropic-oauth",
      "extensions": [
        "+src/index.ts"
      ]
    },
    "{{env.HOME}}/dev/jf-pi-heartbeat",
    {
      "source": "git:github.com/obra/superpowers",
      "extensions": [
        "-.pi/extensions/superpowers.ts"
      ],
      "skills": [
        "-skills/brainstorming/SKILL.md",
        "-skills/dispatching-parallel-agents/SKILL.md",
        "-skills/executing-plans/SKILL.md",
        "-skills/finishing-a-development-branch/SKILL.md",
        "-skills/receiving-code-review/SKILL.md",
        "-skills/requesting-code-review/SKILL.md",
        "-skills/subagent-driven-development/SKILL.md",
        "-skills/test-driven-development/SKILL.md",
        "-skills/using-git-worktrees/SKILL.md",
        "-skills/using-superpowers/SKILL.md",
        "-skills/verification-before-completion/SKILL.md",
        "-skills/writing-plans/SKILL.md",
        "-skills/writing-skills/SKILL.md",
        "-skills/systematic-debugging/SKILL.md",
        "-skills/diagnosing-superpowers/SKILL.md"
      ]
    },
    "git:github.com/capyup/pi-warp",
    {
      "source": "npm:pi-agent-browser-native",
      "extensions": [
        "+dist/extensions/agent-browser/index.js"
      ]
    }
  ],
  "skills": [
    "+../../.agents/skills/org-doc/SKILL.md",
    "-skills/delivery-plan/SKILL.md",
    "-skills/func-arch/SKILL.md",
    "-skills/google-workspace/SKILL.md",
    "-skills/grafana-dashboards/SKILL.md",
    "-skills/jira/SKILL.md",
    "-skills/jira-read/SKILL.md",
    "-skills/local-dev/SKILL.md",
    "-skills/n2c-pr-review/SKILL.md",
    "-skills/org-doc/SKILL.md",
    "-skills/pr-overview/SKILL.md",
    "+skills/plan/SKILL.md",
    "-skills/scalyr-cli/SKILL.md",
    "-skills/start-story/SKILL.md",
    "-skills/sunrise/SKILL.md",
    "-skills/worm-review/SKILL.md",
    "-skills/zolaris-testing/SKILL.md",
    "-skills/jf-test/SKILL.md",
    "-skills/linear-read/SKILL.md"
  ],
  "showCacheMissNotices": true,
  "cacheWarming": "idle",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "defaultTools": [
    "+codemode"
  ],
  "defaultProvider": "jfd",
  "defaultModel": "opus",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "openai-codex/gpt-5.6-terra",
    "anthropic/claude-fable-5-1",
    "openai-codex/gpt-6-astra",
    "anthropic/claude-opus-5-5",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-sol",
    "jfd/opus",
    "zllm/openai/gpt-6.1-sol",
    "zllm/openai/gpt-6-luna"
  ]
}
