#!/usr/bin/env bash
set -euo pipefail

live="$HOME/.pi/agent/settings.json"
shared="$HOME/.pi/agent/settings.shared.json"

[[ -f "$live" && -f "$shared" ]] || exit 0

keys=$(jq -c 'keys' "$shared")
project_live() {
  jq -S --argjson k "$keys" 'with_entries(select(.key as $x | $k | index($x)))' "$live"
}

if ! drift=$(diff -u <(jq -S . "$shared") <(project_live)); then
  echo "pi settings.json drifted from shared — fold into settings.shared.json##template.default:"
  echo "$drift"
  exit 1
fi
