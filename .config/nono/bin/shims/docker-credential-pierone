#!/bin/sh
# Sandbox stand-in for the pierone docker credential helper: returns the session ztoken
# (pi-jvm-session-before), the same oauth2 credential the real helper gives on the host.
case "${1:-}" in
  get) ;;
  store|erase) cat >/dev/null; exit 0 ;;
  list) echo '{}'; exit 0 ;;
  *) echo "docker-credential-pierone (nono sandbox): unsupported action '${1:-}'" >&2; exit 2 ;;
esac
read -r server
token=$(ztoken) || exit 1
jq -n --arg s "$server" --arg t "$token" '{ServerURL: $s, Username: "oauth2", Secret: $t}'
