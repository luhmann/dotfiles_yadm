  "env_credentials": {
    "op://Automation/scalyr-api-token/password": "scalyr_readlog_token",
    "op://Automation/jira-api-token/credential": "JIRA_API_TOKEN",
    "op://Automation/brave-api-key/credential": "BRAVE_API_KEY",
    "op://Automation/kagi-session-token/credential": "KAGI_SESSION_TOKEN",
    "op://Automation/exa-api-key/credential": "EXA_API_KEY"
