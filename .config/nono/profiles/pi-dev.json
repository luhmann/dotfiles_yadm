{
  "extends": [
    "nolabs-ai/pi"
  ],
  "meta": {
    "name": "pi-dev",
    "version": "",
    "description": null,
    "author": null
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "wsl2_proxy_policy": null
